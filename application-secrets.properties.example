# Copie este archivo como .environments/application-secrets.properties.
# Reemplace todos los valores de ejemplo. Nunca versionar el archivo real.

# Base de datos local
db.host=localhost
db.port=3306
db.name=crud_usuarios
db.username=root
db.password=REEMPLAZAR

# JWT: Base64 de al menos 32 bytes aleatorios
jwt.secret=REEMPLAZAR

# Kafka (Aiven). Para Kafka local sin seguridad use security-protocol=PLAINTEXT.
kafka.bootstrap-servers=kafka-xxxx.aivencloud.com:12345
kafka.security-protocol=SASL_SSL
kafka.sasl.mechanism=SCRAM-SHA-256
kafka.username=avnadmin
kafka.password=REEMPLAZAR
# Contenido de ca.pem en una sola linea, con \n donde van los saltos de linea
kafka.ca-cert=-----BEGIN CERTIFICATE-----\nREEMPLAZAR\n-----END CERTIFICATE-----

# Microservicio accounts
accounts.base-url=http://localhost:8081

# Backblaze B2 (Guia 9)
b2.endpoint=https://s3.us-east-005.backblazeb2.com
b2.region=us-east-005
b2.bucket=electiva-users-files
b2.key-id=REEMPLAZAR
b2.application-key=REEMPLAZAR
